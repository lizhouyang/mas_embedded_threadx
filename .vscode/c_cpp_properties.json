{
    "configurations": [
        {
            "name": "STM32",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/utils/kfifo",
                "${workspaceFolder}/board/bsp",
                "${workspaceFolder}/board/bsp/CAN"
            ],
            "defines": [
                "STM32F407xx",
                "USE_HAL_DRIVER"
